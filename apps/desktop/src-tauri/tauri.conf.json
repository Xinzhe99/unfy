{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unfy",
  "version": "0.1.0",
  "identifier": "app.unfy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unfy",
        "width": 896,
        "height": 679,
        "minWidth": 720,
        "minHeight": 520,
        "visible": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "publisher": "Unfy",
    "category": "Utility",
    "shortDescription": "Keep remote-session windows on the display the client can see",
    "longDescription": "Unfy notices when a remote client is connected to this machine, gathers the windows from your other displays onto the one the client can see, and puts them back when the session ends."
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
